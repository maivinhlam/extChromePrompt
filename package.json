{
  "name": "flow-prompt-runner",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension automation for Google Labs Flow",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "watch": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.306",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.4.10"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}
